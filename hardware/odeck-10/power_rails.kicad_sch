	(label "5V_BUCK"
		(at 35.56 33.02 270)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "80215890-e480-4702-86aa-363c6d2be6ee")
	)
	(text "1. +5V MAIN BUCK  LM5148 (80 V sync buck controller)  VIN 9-50 V -> 5V_BUCK = 5.13 V, 8 A, fsw 300 kHz"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "5be4a728-21b0-4c75-80cd-0ea425ce3884")
	)
	(text "fsw = 1e6/(45*73.2k+53) = 299 kHz; tON at 50.4 V = 340 ns >> 50 ns min; dropout below ~5.3 V (VIN UVLO is 8 V)."
		(exclude_from_sim no)
		(at 20.32 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "79410a04-8abd-4947-934f-6d014d86ccb1")
	)
	(text "L = 4.7 uH: dI = 3.25 A p-p at 48 V, 2.7 A at 20 V. Slope comp: L_ideal = Vo*Rs/(24*f) = 2.85 uH -> 1.65x (stable)."
		(exclude_from_sim no)
		(at 20.32 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "807755e6-bda2-4fff-ad1e-e10296f613a5")
	)
	(text "Rs = 4 mOhm, VCS-TH 49/60/73 mV -> peak limit 12.3/15/18.3 A, DC >= 10.6 A at 48 V; short-circuit peak 18.7 A < 24 A Isat."
		(exclude_from_sim no)
		(at 20.32 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e98f1ead-b222-4d94-8f18-0442028ead77")
	)
	(text "Comp (gm 1.2 mS, Gcs 10): RCOMP 10k, CCOMP 10n (zero 1.6 kHz), CHF 100p (pole 159 kHz)."
		(exclude_from_sim no)
		(at 20.32 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7b658597-3c9c-48df-bd42-b0974f5807f1")
	)
	(text "  fc = 18 kHz with ~430 uF total (+5V bulk + ceramics); 52 kHz with buck-side ceramics only (~150 uF) - both < fsw/5."
		(exclude_from_sim no)
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "253dad4b-5548-4fa6-974c-80bdbda2894b")
	)
	(text "PFM/SYNC = VDDA: diode emulation, no negative inductor current (cannot pump +5V energy back into VIN)."
		(exclude_from_sim no)
		(at 20.32 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "daad788e-eb67-49ad-b022-de185ebba9a7")
	)
	(text "VCCX = own output (> 4.3 V): gate drive from 5 V instead of the VIN LDO (saves ~0.5 W at 48 V)."
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "03e3b011-675c-4f6d-8a45-29ce595ce166")
	)
	(text "Loss at 8 A: ~2.6 W (20 V in, 94 %), ~3.6 W (48 V in, 92 %); incl. OR-FET + INA shunt: 93.3 % / 91.4 %."
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "733d4d4d-67dc-48d4-8fa5-0d7ead8d1d11")
	)
	(text "2. BACKFEED BLOCK  5V_BUCK -> ideal diode (LM74700 + BSC0901NS) -> 5V_OR -> 2 mOhm shunt -> +5V"
		(exclude_from_sim no)
		(at 20.32 241.3 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "3bf068af-7154-4727-95ee-17aaf6fb76df")
	)
	(text "PROBLEM: in bus-powered mode +5V is fed from laptop VBUS (sink switch, power_laptop sheet) while VIN is absent."
		(exclude_from_sim no)
		(at 20.32 292.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4237965b-ec3f-4440-999a-98ab42f7f679")
	)
	(text "A plain sync buck would conduct +5V -> L -> Q301 body diode -> VIN (~4.3 V on VIN, which would also wake the"
		(exclude_from_sim no)
		(at 20.32 294.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3e2d2c46-fdda-4d64-9222-8b59290399ad")
	)
	(text "LM51770 buck-boost at its 3.5 V UVLO and the LM5148's VOUT->VIN ESD diode would conduct too)."
		(exclude_from_sim no)
		(at 20.32 297.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "14997a72-9812-43d1-99e4-ba7e9e9e8c43")
	)
	(text "FIX: the buck regulates its own node 5V_BUCK; LM74700 + Q303 form an ideal diode 5V_BUCK -> +5V."
		(exclude_from_sim no)
		(at 20.32 299.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "81b00883-3911-4ac6-b087-8a724ff1da21")
	)
	(text "  VIN absent: LM74700 unpowered (ANODE ~0 V), Q303 off, its body diode reverse-biased -> zero reverse current."
		(exclude_from_sim no)
		(at 20.32 302.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "28006d72-b3c0-4b18-a484-e3924a2cf5b3")
	)
	(text "  Buck running: Q303 regulated to 20 mV forward drop (0.16 W at 8 A); reverse current -> gate pulled in <0.75 us."
		(exclude_from_sim no)
		(at 20.32 304.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e6a05a86-9915-4c80-880e-70b5bcff88da")
	)
	(text "  Nothing on this sheet ties VIN-side pins to +5V (FB, VCCX, VOUT/ISNS+, PG pull-up all on 5V_BUCK)."
		(exclude_from_sim no)
		(at 20.32 307.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "46d8984a-f129-4346-b4e2-01e9c6a83ffa")
	)
	(text "  VIN at a few volts: EN/UVLO divider keeps the LM5148 off below 7.0-8.0 V, D301 isolates its VIN pin."
		(exclude_from_sim no)
		(at 20.32 309.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "21580eb8-b674-47d3-b0c4-2a71d31a1a2e")
	)
	(text "Handover: external power arrives -> buck soft-starts (3 ms) into 5V_BUCK -> diode conducts once 5V_BUCK > +5V,"
		(exclude_from_sim no)
		(at 20.32 312.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f1557242-0f8c-49d1-88bb-ab7017470ffb")
	)
	(text "  +5V rises 5.0 -> 5.11 V, EXT_PWR_PRESENT opens the sink switch. Loss of VIN: +5V held by 330 uF + ceramics."
		(exclude_from_sim no)
		(at 20.32 314.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fe823dc4-8525-46f4-be9c-e6c8868e14a9")
	)
	(text "INA226 @ 0x41 (A1=GND, A0=VS): 2 mOhm, 8 A = 16 mV of +-81.92 mV FS; CURRENT_LSB 0.5 mA -> CAL = 5120."
		(exclude_from_sim no)
		(at 20.32 317.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ac7a725f-4bb2-4baa-8fb3-b0e1f51a5b68")
	)
	(text "  Measures buck output only; bus-powered +5V current is seen by the laptop-VBUS INA226 (power_laptop)."
		(exclude_from_sim no)
		(at 20.32 320.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
