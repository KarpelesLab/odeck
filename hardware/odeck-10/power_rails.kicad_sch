	(label "5V_BUCK"
		(at 35.56 33.02 270)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "48252a27-2723-4347-89f6-1ddab36421de")
	)
	(text "1. +5V MAIN BUCK  LM5148 (80 V sync buck controller)  VIN 9-50 V -> 5V_BUCK = 5.13 V, 8 A, fsw 300 kHz"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "1cf59fea-b46b-4d0f-aef3-377e4a0fc7c6")
	)
	(text "fsw = 1e6/(45*73.2k+53) = 299 kHz; tON at 50.4 V = 340 ns >> 50 ns min; dropout below ~5.3 V (VIN UVLO is 8 V)."
		(exclude_from_sim no)
		(at 20.32 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e184546-a721-4c32-bf30-e69a562ebd38")
	)
	(text "L = 4.7 uH: dI = 3.25 A p-p at 48 V, 2.7 A at 20 V. Slope comp: L_ideal = Vo*Rs/(24*f) = 2.85 uH -> 1.65x (stable)."
		(exclude_from_sim no)
		(at 20.32 213.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "327b9ee0-d609-4917-8f77-c01c84378137")
	)
	(text "Rs = 4 mOhm, VCS-TH 49/60/73 mV -> peak limit 12.3/15/18.3 A, DC >= 10.6 A at 48 V; short-circuit peak 18.7 A < 24 A Isat."
		(exclude_from_sim no)
		(at 20.32 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e7b5cc00-6e0e-4a6e-aa73-fc9949a7a131")
	)
	(text "Comp (gm 1.2 mS, Gcs 10): RCOMP 10k, CCOMP 10n (zero 1.6 kHz), CHF 100p (pole 159 kHz)."
		(exclude_from_sim no)
		(at 20.32 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "26ec0a4c-031e-441a-bb06-1b0dab8b724d")
	)
	(text "  fc = 18 kHz with ~430 uF total (+5V bulk + ceramics); 52 kHz with buck-side ceramics only (~150 uF) - both < fsw/5."
		(exclude_from_sim no)
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "75333847-99b4-4fe3-be33-67a556dc86c4")
	)
	(text "PFM/SYNC = VDDA: diode emulation, no negative inductor current (cannot pump +5V energy back into VIN)."
		(exclude_from_sim no)
		(at 20.32 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e6491c6b-ce58-4774-8960-0a0072ad50ff")
	)
	(text "VCCX = own output (> 4.3 V): gate drive from 5 V instead of the VIN LDO (saves ~0.5 W at 48 V)."
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d673181b-f78c-473d-857d-12bb070061c3")
	)
	(text "Loss at 8 A: ~2.6 W (20 V in, 94 %), ~3.6 W (48 V in, 92 %); incl. OR-FET + INA shunt: 93.3 % / 91.4 %."
		(exclude_from_sim no)
		(at 20.32 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a584a621-772a-4a17-90eb-d259078a2d8d")
	)
	(text "2. BACKFEED BLOCK  5V_BUCK -> ideal diode (LM74700 + BSC0901NS) -> 5V_OR -> 2 mOhm shunt -> +5V"
		(exclude_from_sim no)
		(at 20.32 241.3 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left top)
		)
		(uuid "3c0b0d5a-5088-4d79-8984-d06409134f96")
	)
	(text "PROBLEM: in bus-powered mode +5V is fed from laptop VBUS (sink switch, power_laptop sheet) while VIN is absent."
		(exclude_from_sim no)
		(at 20.32 292.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ced7f366-8194-4d5c-8bd6-5292cdce196d")
	)
	(text "A plain sync buck would conduct +5V -> L -> Q301 body diode -> VIN (~4.3 V on VIN, which would also wake the"
		(exclude_from_sim no)
		(at 20.32 294.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7be19849-ddcf-48be-aa51-8a4ff8938623")
	)
	(text "LM51770 buck-boost at its 3.5 V UVLO and the LM5148's VOUT->VIN ESD diode would conduct too)."
		(exclude_from_sim no)
		(at 20.32 297.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0afd6498-ce48-4cf4-9f56-c424be5a0c3e")
	)
	(text "FIX: the buck regulates its own node 5V_BUCK; LM74700 + Q303 form an ideal diode 5V_BUCK -> +5V."
		(exclude_from_sim no)
		(at 20.32 299.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "565bbd6d-82a4-4f6e-8831-d84b1fff9bcb")
	)
	(text "  VIN absent: LM74700 unpowered (ANODE ~0 V), Q303 off, its body diode reverse-biased -> zero reverse current."
		(exclude_from_sim no)
		(at 20.32 302.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "51493110-0a9e-4681-b11f-e2e8f2081306")
	)
	(text "  Buck running: Q303 regulated to 20 mV forward drop (0.16 W at 8 A); reverse current -> gate pulled in <0.75 us."
		(exclude_from_sim no)
		(at 20.32 304.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ba192787-7c96-41fe-8398-e58a539ca709")
	)
	(text "  Nothing on this sheet ties VIN-side pins to +5V (FB, VCCX, VOUT/ISNS+, PG pull-up all on 5V_BUCK)."
		(exclude_from_sim no)
		(at 20.32 307.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7b6ede30-df25-4a77-8e31-cce0f6efb7cc")
	)
	(text "  VIN at a few volts: EN/UVLO divider keeps the LM5148 off below 7.0-8.0 V, D301 isolates its VIN pin."
		(exclude_from_sim no)
		(at 20.32 309.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c4db51cd-2bd5-4c17-a2fc-c65b231f22d4")
	)
	(text "Handover: external power arrives -> buck soft-starts (3 ms) into 5V_BUCK -> diode conducts once 5V_BUCK > +5V,"
		(exclude_from_sim no)
		(at 20.32 312.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "39293929-de14-4f03-ae7d-2cf404112c4d")
	)
	(text "  +5V rises 5.0 -> 5.11 V, EXT_PWR_PRESENT opens the sink switch. Loss of VIN: +5V held by 330 uF + ceramics."
		(exclude_from_sim no)
		(at 20.32 314.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8d99fcae-ddea-4ab1-a3c7-8fd5b26a874c")
	)
	(text "INA226 @ 0x41 (A1=GND, A0=VS): 2 mOhm, 8 A = 16 mV of +-81.92 mV FS; CURRENT_LSB 0.5 mA -> CAL = 5120."
		(exclude_from_sim no)
		(at 20.32 317.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "092a5ca1-ee98-4d40-8aed-cfbda7f41843")
	)
	(text "  Measures buck output only; bus-powered +5V current is seen by the laptop-VBUS INA226 (power_laptop)."
		(exclude_from_sim no)
		(at 20.32 320.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "887e8182-97e5-480e-beb4-93e51ac1028d")
