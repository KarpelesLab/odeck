	(text "1. LAPTOP USB-C (UFP data, EPR source up to 28 V x 5 A, bus-powered sink 5 V)"
		(exclude_from_sim no)
		(at 20.32 12.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b257d560-f628-464b-b8fd-b4e9584569fa")
	)
	(text "JAE DX07S024XJ1R1100 (C134113): 48 V / 5 A, USB 3.x 10G. Shell -> GND (direct, JLC practice; via-stitch to plane)."
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5c5abcb7-b653-47c4-b34f-a324bcbe4665")
	)
	(text "Pins by number (A row / B row checked vs USB Type-C R2.x receptacle table and symbol names):"
		(exclude_from_sim no)
		(at 20.32 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "82ff8111-9bd1-4e8d-adbc-3186a9df72e6")
	)
	(text "  A2/A3 TX1+/-  B2/B3 TX2+/-  (ours: TUSB1064 TX through 220 nF)  B11/B10 RX1+/-  A11/A10 RX2+/-  (DC to TUSB1064 RX)"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dab12bf4-2238-4c81-ae46-8c0f419d302f")
	)
	(text "  A6/B6 D+ and A7/B7 D- tied at the connector -> LAPTOP_USB_DP/DN (hub upstream USB2).  A8/B8 SBU1/2 -> TPD4S480."
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8c6a7cb3-067c-40e9-8f45-08c01b1c3728")
	)
	(text "VBUS TVS SMBJ30A: VRWM 30 V > 29.4 V (28 V EPR +5 %), VBR 33.3 V min, below PMG1 VBUS abs max 34 V at low current;"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e4a0638b-c573-4ea5-9431-a9c3a3353799")
	)
	(text "  OVP (power_laptop) trips at ~30.8 V, LM74800 backstop 32.6 V.  Only 100 nF on VBUS here (cSnkBulk budget on power_laptop)."
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d30fd2f3-5b18-4c4f-9bae-e229cb4519ee")
	)
	(text "TPD4S480 (C43131250): 63 V short-to-VBUS OVP + IEC ESD on CC1/CC2/SBU1/SBU2 (PMG1 CC/SBU pins are 6 V abs max)."
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "15d2f10f-a565-4eb0-b3ac-f6d1262480b8")
	)
	(text "  VPWR = PMG1_VDDD: the PMG1 always-on rail (from VBUS or the deck). It MUST be up whenever PMG1 runs, otherwise the CC"
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3d4c11bf-dcbf-4a69-9cb2-32934c4be055")
	)
	(text "  FETs stay open and the laptop sees only the dead-battery Rd.  RPD_Gx = C_CCx: dead-battery Rd while VPWR is off, so a"
		(exclude_from_sim no)
		(at 20.32 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "41b9f28f-5b34-4b72-acc2-9ae20c40a1d5")
	)
	(text "  laptop applies 5 V to a dead deck (bus-powered cold start).  Removed 3.5 ms after VPWR is up -> PMG1 owns CC (Rp/Rd/DRP)."
		(exclude_from_sim no)
		(at 20.32 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "66c66b86-2974-498f-a1b5-289bb0151f24")
	)
	(text "  EPR_EN = VPWR (divider always on, keeps unloaded VBUS_LV < 24 V abs max); VBUS_LV, EPR_BLK_G open (PMG1 senses 28 V)."
		(exclude_from_sim no)
		(at 20.32 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fc2135ea-c923-4e70-a6c3-860af99808f3")
	)
	(text "  FLT# (open drain) -> UP_CCPROT_FLT_N, pulled up to PMG1_VDDD; route to a PMG1 GPIO if pins allow (optional)."
		(exclude_from_sim no)
		(at 20.32 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fa03d6b2-b75e-4d15-abce-aa4f6a5df8dd")
	)
	(text "ESD: TPD4E02B04 (0.25 pF, 10 Gbps) on all 8 SS lines + USB2, at the connector, flow-through (route over pads 1-10, 2-9, 4-7, 5-6)."
		(exclude_from_sim no)
		(at 20.32 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c7bde8d4-0c49-4877-a1a4-09d3b6660e89")
	)
	(text "2. TUSB1064 UFP_D MUX/REDRIVER  (TUSB1064IRNQT C702365, GPIO mode: I2C_EN = 0)"
		(exclude_from_sim no)
		(at 170.18 12.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
